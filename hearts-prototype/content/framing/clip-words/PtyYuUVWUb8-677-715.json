{"version":1,"youtubeId":"PtyYuUVWUb8","start":677,"end":715,"segments":[{"start":677,"end":715,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"The point of hermeneutics is not for people to go","s":677.12,"e":680.52,"next":680.52,"key":"hermeneutics","words":[{"w":"The","t":677.12},{"w":"point","t":677.27},{"w":"of","t":677.42},{"w":"hermeneutics","t":677.57},{"w":"is","t":678.24},{"w":"not","t":678.48},{"w":"for","t":679.44},{"w":"people","t":679.76},{"w":"to","t":680.08},{"w":"go","t":680.28}]},{"text":"searching for proof texts.","s":680.52,"e":682.56,"next":682.56,"key":"searching","words":[{"w":"searching","t":680.52},{"w":"for","t":680.96},{"w":"proof","t":681.24},{"w":"texts.","t":681.56}]},{"text":"What I mean by proof text is where we get in an argument with someone","s":682.56,"e":686.6,"next":686.6,"key":"argument","words":[{"w":"What","t":682.56},{"w":"I","t":682.71},{"w":"mean","t":682.86},{"w":"by","t":683.01},{"w":"proof","t":683.24},{"w":"text","t":683.56},{"w":"is","t":684.36},{"w":"where","t":684.64},{"w":"we","t":685.16},{"w":"get","t":685.36},{"w":"in","t":685.51},{"w":"an","t":685.66},{"w":"argument","t":685.81},{"w":"with","t":686.16},{"w":"someone","t":686.32}]},{"text":"that we don't like.","s":686.6,"e":688.44,"next":688.44,"key":"don't","words":[{"w":"that","t":686.6},{"w":"we","t":686.75},{"w":"don't","t":686.9},{"w":"like.","t":687.44}]},{"text":"And we search a verse because they've disagreed with us on some","s":688.44,"e":691.48,"next":691.48,"key":"disagreed","words":[{"w":"And","t":688.44},{"w":"we","t":688.64},{"w":"search","t":688.8},{"w":"a","t":689.48},{"w":"verse","t":689.63},{"w":"because","t":689.96},{"w":"they've","t":690.16},{"w":"disagreed","t":690.36},{"w":"with","t":690.84},{"w":"us","t":690.99},{"w":"on","t":691.14},{"w":"some","t":691.29}]},{"text":"manner, so we search out a verse to disagree with them with,","s":691.48,"e":695.44,"next":695.44,"key":"disagree","words":[{"w":"manner,","t":