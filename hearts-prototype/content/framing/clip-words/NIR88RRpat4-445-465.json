{"version":1,"youtubeId":"NIR88RRpat4","start":445,"end":465,"segments":[{"start":445,"end":465,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"There was a time in my life when I was literally spiritually dead.","s":445,"e":448.8,"next":448.8,"key":"spiritually","words":[{"w":"There","t":445},{"w":"was","t":445.15},{"w":"a","t":445.3},{"w":"time","t":445.45},{"w":"in","t":445.6},{"w":"my","t":445.84},{"w":"life","t":446},{"w":"when","t":446.16},{"w":"I","t":446.32},{"w":"was","t":446.56},{"w":"literally","t":446.71},{"w":"spiritually","t":447.04},{"w":"dead.","t":447.68}]},{"text":"Meaning I, I, I couldn't feel empathy for another person.","s":448.8,"e":452.24,"next":452.24,"key":"couldn't","words":[{"w":"Meaning","t":448.8},{"w":"I,","t":449.12},{"w":"I,","t":449.28},{"w":"I","t":449.43},{"w":"couldn't","t":449.76},{"w":"feel","t":450},{"w":"empathy","t":450.24},{"w":"for","t":450.72},{"w":"another","t":450.96},{"w":"person.","t":451.36}]},{"text":"I couldn't feel empathy for my own self.","s":452.24,"e":455.12,"next":455.12,"key":"couldn't","words":[{"w":"I","t":452.24},{"w":"couldn't","t":452.48},{"w":"feel","t":452.72},{"w":"empathy","t":453.04},{"w":"for","t":453.44},{"w":"my","t":453.68},{"w":"own","t":453.92},{"w":"self.","t":454.08}]},{"text":"I didn't know where to go for anything.","s":455.12,"e":457.52,"next":457.52,"key":"anything","words":[{"w":"I","t":455.12},{"w":"didn't","t":455.36},{"w":"know","t":455.6},{"w":"where","t":455.92},{"w":"to","t":456.32},{"w":"go","t":456.64},{"w":"for","t":456.88},{"w":"anything.","t":457.12}]},{"text":"I didn't understand what was my purpose.","s":457.52,"e":460,"next":460,"key":"understand","words":[{"w":"I","t":457.52},{"w":"didn't","t":457.76},{"w":"understand","t":457.92},{"w":"what","t":458.96},{"w":"was","t":459.2},{"w":"my","t":459.36},{"w":"purpose.","t":459.6}]},{"text":"What am I here for?","s":460,"e":461.76,"next":461.76,"key":"What","words":[{"w":"What","t":460},{"w":"am","t":460.24},{"w":"I","t":460.4},{"w":"here","t":460.56},{"w":"for?","t":460.8}]},{"text":"And that's what connection to Allah subhanahu wa ta'ala gives.","s":461.76,"e":465,"next":465,"key":"connection","words":[{"w":"And","t":461.76},{"w":"that's","t":462.08},{"w":"what","t":462.32},{"w":"connection","t":462.64},{"w":"to","t":463.04},{"w":"Allah","t":463.28},{"w":"subhanahu","t":463.6},{"w":"wa","t":463.92},{"w":"ta'ala","t":464.08},{"w":"gives.","t":464.48}]}]}
