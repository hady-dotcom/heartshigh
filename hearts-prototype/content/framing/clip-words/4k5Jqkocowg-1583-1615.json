{"version":1,"youtubeId":"4k5Jqkocowg","start":1583,"end":1615,"segments":[{"start":1583,"end":1615,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"this verse was revealed, Sayyidina Bilal came to wake him up as he would","s":1583.58,"e":1588.32,"next":1588.32,"key":"Sayyidina","words":[{"w":"this","t":1583.58},{"w":"verse","t":1583.82},{"w":"was","t":1584.06},{"w":"revealed,","t":1584.24},{"w":"Sayyidina","t":1585.56},{"w":"Bilal","t":1586.22},{"w":"came","t":1586.7},{"w":"to","t":1586.94},{"w":"wake","t":1587.09},{"w":"him","t":1587.24},{"w":"up","t":1587.42},{"w":"as","t":1587.6},{"w":"he","t":1587.96},{"w":"would","t":1588.14}]},{"text":"take permission to make adhan.","s":1588.32,"e":1590,"next":1590,"key":"permission","words":[{"w":"take","t":1588.32},{"w":"permission","t":1588.8},{"w":"to","t":1589.1},{"w":"make","t":1589.64},{"w":"adhan.","t":1589.79}]},{"text":"And he saw the Prophet, alayhis salam, crying.","s":1590,"e":1591.5,"next":1591.5,"key":"Prophet","words":[{"w":"And","t":1590},{"w":"he","t":1590.36},{"w":"saw","t":1590.51},{"w":"the","t":1590.66},{"w":"Prophet,","t":1590.81},{"w":"alayhis","t":1590.96},{"w":"salam,","t":1591.11},{"w":"crying.","t":1591.26}]},{"text":"He said, Ya Rasulallah, what makes you cry?","s":1591.5,"e":1593.73,"next":1593.73,"key":"Rasulallah","words":[{"w":"He","t":1591.5},{"w":"said,","t":1592.1},{"w":"Ya","t":1592.36},{"w":"Rasulallah,","t":1592.59},{"w":"what","t":1592.82},{"w":"makes","t":1593.05},{"w":"you","t":1593.27},{"w":"cry?","t":1593.5}]},{"text":"Ya Rasulallah?","s":1593.73,"e":1595.16,"next":1595.16,"key":"Rasulallah","words":[{"w":"Ya","t":1593.73},{"w":"Rasulallah?","t":1593.96}]},{"text":"He said,","s":1595.16,"e":1596.92,"next":1600.79,"key":"said","words":[{"w":"He","t":1595.16},{"w":"said,","t":1595.52}]},{"text":"and he recited these verses, How shall I not cry?","s":1600.79,"e":1602.29,"next":1602.29,"key":"recited","words":[{"w":"and","t":1600.79},{"w":"he","t":1600.94},{