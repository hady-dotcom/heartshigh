{"version":1,"youtubeId":"7CRTtTDNPj4","start":2937,"end":2969,"segments":[{"start":2937,"end":2969,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"see you for what you are and deny your claims.","s":2937.55,"e":2939.05,"next":2939.05,"key":"claims","words":[{"w":"see","t":2937.55},{"w":"you","t":2937.7},{"w":"for","t":2937.85},{"w":"what","t":2938},{"w":"you","t":2938.15},{"w":"are","t":2938.3},{"w":"and","t":2938.45},{"w":"deny","t":2938.6},{"w":"your","t":2938.75},{"w":"claims.","t":2938.9}]},{"text":"No one responded, My people, do you not see me upon clear guidance from my","s":2939.05,"e":2941.3,"next":2941.3,"key":"responded","words":[{"w":"No","t":2939.05},{"w":"one","t":2939.2},{"w":"responded,","t":2939.35},{"w":"My","t":2939.5},{"w":"people,","t":2939.65},{"w":"do","t":2939.8},{"w":"you","t":2939.95},{"w":"not","t":2940.1},{"w":"see","t":2940.25},{"w":"me","t":2940.4},{"w":"upon","t":2940.55},{"w":"clear","t":2940.7},{"w":"guidance","t":2940.85},{"w":"from","t":2941},{"w":"my","t":2941.15}]},{"text":"Lord? And He has granted me favor from His presence?","s":2941.3,"e":2942.8,"next":2942.8,"key":"presence","words":[{"w":"Lord?","t":2941.3},{"w":"And","t":2941.45},{"w":"He","t":2941.6},{"w":"has","t":2941.75},{"w":"granted","t":2941.9},{"w":"me","t":2942.05},{"w":"favor","t":2942.2},{"w":"from","t":2942.35},{"w":"His","t":2942.5},{"w":"presence?","t":2942.65}]},{"text":"While you have been blinded to the truth.","s":2942.8,"e":2944,"next":2944,"key":"blinded","words":[{"w":"While","t":2942.8},{"w":"you","t":2942.95},{"w":"have","t":2943.1},{"w":"been","t":2943.25},{"w":"blinded","t":2943.4},{"w":"to","t":2943.55},{"w":"the","t":2943.7},{"w":"truth.","t":2943.85}]},{"text":"Are we going to force you to accept this while you hate it?","s":2944,"e":2946.5,"next":2946.5,"key":"accept","words":[{"w":"Are","t":2944},{"w":"we","t":2944.15},{"w":"going","t":2944.3},{"w":"to","t":2944.45},{"w":"force","t":2944.6},{"w":"you","t":2944.75},{"w":"to","t":2944.9},{"w":"accept","t":2945.05},{"w":"this","t":2945.2},{"w":"while","t":2945.35},{"w":"you","t":2945.59},{"w":"hate","t":2945.8},{"w":"it?","t":2946.15}]},{"text":"My people, I am not asking for any wealth as my own reward.","s":2946.5,"e":2951.19,"next":2951.19,"key":"people","words":[{"w":"My","t":2946.5},{"w":"people,","t":2946.85},{"w":"I","t":2947.2},{"w":"am","t":2947.55},{"w":"not","t":2947.91},{"w":"asking","t":2948.26},{"w":"for","t":2948.61},{"w":"any","t":2948.96},{"w":"wealth","t":2949.28},{"w":"as","t":2949.66},{"w":"my","t":2950.04},{"w":"own","t":2950.43},{"w":"reward.","t":2950.81}]},{"text":"My own reward is only with Allah.","s":2951.19,"e":2953.48,"next":2953.48,"key":"reward","words":[{"w":"My","t":2951.19},{"w":"own","t":2951.57},{"w":"reward","t":2951.95},{"w":"is","t":2952.28},{"w":"only","t":2952.58},{"w":"with","t":2952.88},{"w":"Allah.","t":2953.18}]},{"text":"I am not some rebel that has caused.","s":2953.48,"e":2955.63,"next":2955.63,"key":"caused","words":[{"w":"I","t":2953.48},{"w":"am","t":2953.78},{"w":"not","t":2954.08},{"w":"some","t":2954.38},{"w":"rebel","t":2954.68},{"w":"that","t":2954.96},{"w":"has","t":2955.18},{"w":"caused.","t":2955.4}]},{"text":"Those who have faith to turn to me.","s":2955.63,"e":2958.6,"next":2958.8,"key":"Those","words":[{"w":"Those","t":2955.63},{"w":"who","t":2955.85},{"w":"have","t":2956.07},{"w":"faith","t":2956.29},{"w":"to","t":2956.51},{"w":"turn","t":2956.74},{"w":"to","t":2956.96},{"w":"me.","t":2957.2}]},{"text":"Call those who have faith to turn to me.","s":2958.8,"e":2960.6,"next":2960.6,"key":"those","words":[{"w":"Call","t":2958.8},{"w":"those","t":2959},{"w":"who","t":2959.2},{"w":"have","t":2959.4},{"w":"faith","t":2959.6},{"w":"to","t":2959.8},{"w":"turn","t":2960},{"w":"to","t":2960.2},{"w":"me.","t":2960.4}]},{"text":"And hold them by force to make them meet their Lord in this state.","s":2960.6,"e":2964.18,"next":2964.18,"key":"force","words":[{"w":"And","t":2960.6},{"w":"hold","t":2960.8},{"w":"them","t":2961.04},{"w":"by","t":2961.27},{"w":"force","t":2961.51},{"w":"to","t":2961.74},{"w":"make","t":2961.98},{"w":"them","t":2962.21},{"w":"meet","t":2962.44},{"w":"their","t":2962.68},{"w":"Lord","t":2962.92},{"w":"in","t":2963.24},{"w":"this","t":2963.55},{"w":"state.","t":2963.87}]},{"text":"But I see you as a people of grave ignorance.","s":2964.18,"e":2968.88,"next":2969,"key":"ignorance","words":[{"w":"But","t":2964.18},{"w":"I","t":2964.5},{"w":"see","t":2964.81},{"w":"you","t":2965.13},{"w":"as","t":2965.44},{"w":"a","t":2965.76},{"w":"people","t":2966.04},{"w":"of","t":2966.52},{"w":"grave","t":2967},{"w":"ignorance.","t":2967.48}]}]}
