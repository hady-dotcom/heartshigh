{"version":1,"youtubeId":"IEcZq1tdQp0","start":2424,"end":2442,"segments":[{"start":2424,"end":2442,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"Or the Sahhabi who wept, and they said, Why do you cry?","s":2424.32,"e":2427.12,"next":2427.12,"key":"Sahhabi","words":[{"w":"Or","t":2424.32},{"w":"the","t":2424.48},{"w":"Sahhabi","t":2424.64},{"w":"who","t":2425.2},{"w":"wept,","t":2425.36},{"w":"and","t":2425.6},{"w":"they","t":2425.76},{"w":"said,","t":2425.92},{"w":"Why","t":2426.16},{"w":"do","t":2426.56},{"w":"you","t":2426.72},{"w":"cry?","t":2426.88}]},{"text":"Is it because you're waiting and wishing that Muhammad was here?","s":2427.12,"e":2430.48,"next":2430.48,"key":"Muhammad","words":[{"w":"Is","t":2427.12},{"w":"it","t":2427.27},{"w":"because","t":2427.44},{"w":"you're","t":2428.4},{"w":"waiting","t":2428.64},{"w":"and","t":2428.96},{"w":"wishing","t":2429.2},{"w":"that","t":2429.44},{"w":"Muhammad","t":2429.68},{"w":"was","t":2430.08},{"w":"here?","t":2430.32}]},{"text":"Instead? He said, No.","s":2430.48,"e":2431.68,"next":2431.68,"key":"Instead","words":[{"w":"Instead?","t":2430.48},{"w":"He","t":2430.8},{"w":"said,","t":2430.96},{"w":"No.","t":2431.11}]},{"text":"He said, I weep because I only have one life to give.","s":2431.68,"e":2435.36,"next":2435.36,"key":"because","words":[{"w":"He","t":2431.68},{"w":"said,","t":2431.84},{"w":"I","t":2431.99},{"w":"weep","t":2432.16},{"w":"because","t":2432.48},{"w":"I","t":2432.72},{"w":"only","t":2432.96},{"w":"have","t":2433.12},{"w":"one","t":2433.28},{"w":"life","t":2433.52},{"w":"to","t":2433.76},{"w":"give.","t":2434.36}]},{"text":"It's that steadfastness, that courage that should remind you.","s":2435.36,"e":2442,"next":2442,"key":"steadfastness","words":[{"w":"It's","t":2435.36},{"w":"that","t":2435.72},{"w":"steadfastness,","t":2436.76},{"w":"that","t":2437.76},{"w":"courage","t":2439.32},{"w":"that","t":2440.32},{"w":"should","t":2440.64},{"w":"remind","t":2440.88},{"w":