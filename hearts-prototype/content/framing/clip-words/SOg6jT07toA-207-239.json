","t":235.54},{"w":"He","t":235.69},{"w":"will","t":235.92},{"w":"give","t":236.12},{"w":"it","t":236.4},{"w":"to","t":236.56},{"w":"you.","t":236.71}]},{"text":"It is what it is.","s":237,"e":238.88,"next":239,"key":"what","words":[{"w":"It","t":237},{"w":"is","t":237.2},{"w":"what","t":237.36},{"w":"it","t":237.52},{"w":"is.","t":237.67}]}]}
