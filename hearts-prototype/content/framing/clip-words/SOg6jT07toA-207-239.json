{"version":1,"youtubeId":"SOg6jT07toA","start":207,"end":239,"segments":[{"start":207,"end":239,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"And he comes into her room of worship where she's at, and he asks her,","s":207.44,"e":211.19,"next":211.19,"key":"worship","words":[{"w":"And","t":207.44},{"w":"he","t":207.68},{"w":"comes","t":207.83},{"w":"into","t":208.16},{"w":"her","t":208.56},{"w":"room","t":208.76},{"w":"of","t":208.96},{"w":"worship","t":209.12},{"w":"where","t":209.56},{"w":"she's","t":209.71},{"w":"at,","t":209.96},{"w":"and","t":210.2},{"w":"he","t":210.35},{"w":"asks","t":210.68},{"w":"her,","t":211.04}]},{"text":"like, Malaki Hadha, like, what are these things?","s":211.19,"e":213.28,"next":213.28,"key":"Malaki","words":[{"w":"like,","t":211.19},{"w":"Malaki","t":211.36},{"w":"Hadha,","t":211.76},{"w":"like,","t":212.12},{"w":"what","t":212.36},{"w":"are","t":212.52},{"w":"these","t":212.67},{"w":"things?","t":212.92}]},{"text":"You have so many things here that no one has given to you.","s":213.28,"e":217.1,"next":217.1,"key":"things","words":[{"w":"You","t":213.28},{"w":"have","t":213.43},{"w":"so","t":213.68},{"w":"many","t":214.16},{"w":"things","t":214.48},{"w":"here","t":214.84},{"w":"that","t":215.56},{"w":"no","t":215.84},{"w":"one","t":216.04},{"w":"has","t":216.24},{"w":"given","t":216.48},{"w":"to","t":216.8},{"w":"you.","t":216.95}]},{"text":"She says, Huwa rizq min indillah.","s":217.1,"e":218.52,"next":218.52,"key":"indillah","words":[{"w":"She","t":217.1},{"w":"says,","t":217.25},{"w":"Huwa","t":217.4},{"w":"rizq","t":217.55},{"w":"min","t":217.72},{"w":"indillah.","t":217.92}]},{"text":"Like this literally came from Allah, and Allah can give to whomever he wills.","s":218.52,"e":221.92,"next":221.92,"key":"literally","words":[{"w":"Like","t":218.52},{"w":"this","t":219.08},{"w":"literally","t":219.32},{"w":"came","t":219.64},{"w":"from","t":219.84},{"w":"Allah,","t":220},{"w":"and","t":220.28},{"w":"