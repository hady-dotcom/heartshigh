{"version":1,"youtubeId":"nLLmze8Pqyw","start":1342,"end":1375,"segments":[{"start":1342,"end":1375,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"Come oh, kafir, one of them went and complained, said,","s":1342.16,"e":1348.32,"next":1348.32,"key":"complained","words":[{"w":"Come","t":1342.16},{"w":"oh,","t":1342.4},{"w":"kafir,","t":1342.56},{"w":"one","t":1344.48},{"w":"of","t":1344.72},{"w":"them","t":1344.87},{"w":"went","t":1345.02},{"w":"and","t":1345.17},{"w":"complained,","t":1345.36},{"w":"said,","t":1346.96}]},{"text":"Isn't it in your religion that people should be called by their names?","s":1348.32,"e":1352,"next":1352,"key":"religion","words":[{"w":"Isn't","t":1348.32},{"w":"it","t":1348.72},{"w":"in","t":1349.28},{"w":"your","t":1349.52},{"w":"religion","t":1349.68},{"w":"that","t":1350.08},{"w":"people","t":1350.32},{"w":"should","t":1350.48},{"w":"be","t":1350.72},{"w":"called","t":1350.87},{"w":"by","t":1351.04},{"w":"their","t":1351.28},{"w":"names?","t":1351.44}]},{"text":"He said, Yes, why then they are calling us by an attribute?","s":1352,"e":1357.64,"next":1358,"key":"attribute","words":[{"w":"He","t":1352},{"w":"said,","t":1352.24},{"w":"Yes,","t":1352.48},{"w":"why","t":1354.08},{"w":"then","t":1354.4},{"w":"they","t":1354.56},{"w":"are","t":1354.72},{"w":"calling","t":1354.88},{"w":"us","t":1355.12},{"w":"by","t":1355.76},{"w":"an","t":1356},{"w":"attribute?","t":1356.24}]},{"text":"I'm not a Kafir, I'm somebody who, following a religion they calling me.","s":1358,"e":1362.72,"next":1362.72,"key":"following","words":[{"w":"I'm","t":1358},{"w":"not","t":1358.24},{"w":"a","t":1358.4},{"w":"Kafir,","t":1358.64},{"w":"I'm","t":1359.52},{"w":"somebody","t":1359.84},{"w":"who,","t":1360.08},{"w":"following","t":1360.24},{"w":"a","t":1360.56},{"w":"religion","t":1360.72},{"w":"they","t":1360.96},{"w":"calling","t":1361.2},{"w":"me.","t":1361.36}]},{"text":"Soam, called the companion and asked him.","s":1362.72,"e":1365.44,"next":1365.44,"key":"companion","words":[{"w":"Soam,","t":1362.72},{"w":"called","t":1363.28},{"w":"the","t":1363.44},{"w":"companion","t":1363.68},{"w":"and","t":1364.08},{"w":"asked","t":1364.24},{"w":"him.","t":1364.48}]},{"text":"They said they are, but they are not believers.","s":1365.44,"e":1367.6,"next":1367.6,"key":"believers","words":[{"w":"They","t":1365.44},{"w":"said","t":1365.6},{"w":"they","t":1365.76},{"w":"are,","t":1365.92},{"w":"but","t":1366.24},{"w":"they","t":1366.4},{"w":"are","t":1366.56},{"w":"not","t":1366.71},{"w":"believers.","t":1366.86}]},{"text":"He said, Then call them by their names.","s":1367.6,"e":1370.84,"next":1371.2,"key":"names","words":[{"w":"He","t":1367.6},{"w":"said,","t":1367.84},{"w":"Then","t":1368.08},{"w":"call","t":1368.56},{"w":"them","t":1368.8},{"w":"by","t":1369.04},{"w":"their","t":1369.2},{"w":"names.","t":1369.44}]},{"text":"Don't offend them.","s":1371.2,"e":1372.8,"next":1372.8,"key":"offend","words":[{"w":"Don't","t":1371.2},{"w":"offend","t":1371.44},{"w":"them.","t":1371.76}]},{"text":"Don't make them feel uncomfortable.","s":1372.8,"e":1375,"next":1375,"key":"uncomfortable","words":[{"w":"Don't","t":1372.8},{"w":"make","t":1373.04},{"w":"them","t":1373.28},{"w":"feel","t":1373.44},{"w":"uncomfortable.","t":1373.68}]}]}
