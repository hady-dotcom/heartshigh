{"version":1,"youtubeId":"rTXO4r5oGnA","start":2369,"end":2402,"segments":[{"start":2369,"end":2402,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"I said, Messenger of Allah, someone gave us a gift of food and some sustenance","s":2369.44,"e":2375.24,"next":2375.24,"key":"sustenance","words":[{"w":"I","t":2369.44},{"w":"said,","t":2369.6},{"w":"Messenger","t":2370.08},{"w":"of","t":2370.52},{"w":"Allah,","t":2370.68},{"w":"someone","t":2371.64},{"w":"gave","t":2372.12},{"w":"us","t":2372.32},{"w":"a","t":2372.47},{"w":"gift","t":2372.68},{"w":"of","t":2372.92},{"w":"food","t":2373.12},{"w":"and","t":2373.92},{"w":"some","t":2374.08},{"w":"sustenance","t":2374.4}]},{"text":"has come our way.","s":2375.24,"e":2376.84,"next":2376.84,"key":"come","words":[{"w":"has","t":2375.24},{"w":"come","t":2375.52},{"w":"our","t":2375.68},{"w":"way.","t":2375.92}]},{"text":"I have put something together for you.","s":2376.84,"e":2379.44,"next":2379.44,"key":"something","words":[{"w":"I","t":2376.84},{"w":"have","t":2376.99},{"w":"put","t":2377.14},{"w":"something","t":2377.32},{"w":"together","t":2377.76},{"w":"for","t":2378},{"w":"you.","t":2378.44}]},{"text":"The Prophet sallallahu alayhi wa sallam said, What did you prepare?","s":2379.44,"e":2385.88,"next":2386.8,"key":"sallallahu","words":[{"w":"The","t":2379.44},{"w":"Prophet","t":2379.68},{"w":"sallallahu","t":2380.12},{"w":"alayhi","t":2380.55},{"w":"wa","t":2380.98},{"w":"sallam","t":2381.41},{"w":"said,","t":2381.84},{"w":"What","t":2382.68},{"w":"did","t":2382.88},{"w":"you","t":2383.08},{"w":"prepare?","t":2384.48}]},{"text":"Said, Hays.","s":2386.8,"e":2387.58,"next":2387.58,"key":"Said","words":[{"w":"Said,","t":2386.8},{"w":"Hays.","t":2387.19}]},{"text":"He, sallallahu alayhi wa sallam, said, Please bring it forward to me.","s":2387.58,"e":2392.84,"next":2392.84,"key":"sallallahu","words":[{"w":"He,","t":2387.58},{"w":"sallallahu","t":2387.97},{"w":"alayhi","t":2388.35},{"w":"wa","t":238