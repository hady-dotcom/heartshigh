{"version":1,"youtubeId":"SGAhWg9XH8o","start":422,"end":464,"segments":[{"start":422,"end":464,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"This is the same as Abi Becker, who was called the keeper of the two belts.","s":422.64,"e":428.72,"next":428.72,"key":"Becker","words":[{"w":"This","t":422.64},{"w":"is","t":422.88},{"w":"the","t":423.03},{"w":"same","t":423.18},{"w":"as","t":423.76},{"w":"Abi","t":424.48},{"w":"Becker,","t":424.72},{"w":"who","t":425.36},{"w":"was","t":425.6},{"w":"called","t":425.84},{"w":"the","t":426.8},{"w":"keeper","t":427.04},{"w":"of","t":427.36},{"w":"the","t":427.51},{"w":"two","t":427.66},{"w":"belts.","t":427.81}]},{"text":"Split her belts in half to give one for them to have the zamam or the reins","s":428.72,"e":432.32,"next":432.32,"key":"Split","words":[{"w":"Split","t":428.72},{"w":"her","t":429.04},{"w":"belts","t":429.19},{"w":"in","t":429.44},{"w":"half","t":429.6},{"w":"to","t":430.16},{"w":"give","t":430.32},{"w":"one","t":430.48},{"w":"for","t":430.72},{"w":"them","t":430.88},{"w":"to","t":431.04},{"w":"have","t":431.2},{"w":"the","t":431.36},{"w":"zamam","t":431.51},{"w":"or","t":431.84},{"w":"the","t":431.99},{"w":"reins","t":432.14}]},{"text":"for the camel, and one to tie her her juba in place.","s":432.32,"e":436.64,"next":436.64,"key":"camel","words":[{"w":"for","t":432.32},{"w":"the","t":432.48},{"w":"camel,","t":432.63},{"w":"and","t":432.88},{"w":"one","t":433.04},{"w":"to","t":433.44},{"w":"tie","t":433.6},{"w":"her","t":433.84},{"w":"her","t":434.8},{"w":"juba","t":435.12},{"w":"in","t":435.44},{"w":"place.","t":435.6}]},{"text":"This is the same Asmab and Tabi Becker,","s":436.64,"e":438.64,"next":438.64,"key":"Becker","words":[{"w":"This","t":436.64},{"w":"is","t":436.8},{"w":"the","t":436.96},{"w":"same","t":437.11},{"w":"Asmab","t":437.28},{"w":"and","t":437.68},{"w":"Tabi","t":437.83},{"w":"Becker,","t":438.08}]},{"text":"who used to carry water well, water from the well on her head.","s":438.64,"e":442.16,"next":442.16,"key":"carry","words":[{"w":"who","t":438.64},{"w":"used","t":438.8},{"w":"to","t":438.96},{"w":"carry","t":439.12},{"w":"water","t":439.52},{"w":"well,","t":439.84},{"w":"water","t":440.32},{"w":"from","t":440.64},{"w":"the","t":440.8},{"w":"well","t":440.95},{"w":"on","t":441.12},{"w":"her","t":441.28},{"w":"head.","t":441.43}]},{"text":"And one day, the Prophet Muhammad Sallallahu Wasallam rode past and saw","s":442.16,"e":445.76,"next":445.76,"key":"Sallallahu","words":[{"w":"And","t":442.16},{"w":"one","t":442.4},{"w":"day,","t":442.56},{"w":"the","t":442.72},{"w":"Prophet","t":442.88},{"w":"Muhammad","t":443.12},{"w":"Sallallahu","t":443.44},{"w":"Wasallam","t":444.08},{"w":"rode","t":444.8},{"w":"past","t":445.12},{"w":"and","t":445.44},{"w":"saw","t":445.6}]},{"text":"her struggling and said, Should I give you a ride?","s":445.76,"e":449.76,"next":449.76,"key":"struggling","words":[{"w":"her","t":445.76},{"w":"struggling","t":446},{"w":"and","t":446.88},{"w":"said,","t":447.12},{"w":"Should","t":447.76},{"w":"I","t":447.92},{"w":"give","t":448.08},{"w":"you","t":448.32},{"w":"a","t":448.48},{"w":"ride?","t":448.64}]},{"text":"And she said, No.","s":449.76,"e":451.88,"next":452.08,"key":"said","words":[{"w":"And","t":449.76},{"w":"she","t":450},{"w":"said,","t":450.16},{"w":"No.","t":450.48}]},{"text":"And when she arrived back, she mentioned this to us and she said.","s":452.08,"e":455.6,"next":455.6,"key":"mentioned","words":[{"w":"And","t":452.08},{"w":"when","t":452.4},{"w":"she","t":452.64},{"w":"arrived","t":452.88},{"w":"back,","t":453.2},{"w":"she","t":453.44},{"w":"mentioned","t":453.68},{"w":"this","t":454},{"w":"to","t":454.15},{"w":"us","t":454.3},{"w":"and","t":454.88},{"w":"she","t":455.03},{"w":"said.","t":455.18}]},{"text":"I didn't do it because I remembered your jealousy, and he said,","s":455.6,"e":458.56,"next":458.56,"key":"remembered","words":[{"w":"I","t":455.6},{"w":"didn't","t":455.76},{"w":"do","t":456},{"w":"it","t":456.16},{"w":"because","t":456.32},{"w":"I","t":456.56},{"w":"remembered","t":456.71},{"w":"your","t":457.04},{"w":"jealousy,","t":457.2},{"w":"and","t":458.08},{"w":"he","t":458.24},{"w":"said,","t":458.4}]},{"text":"there was no jealousy to remember.","s":458.56,"e":460.32,"next":460.32,"key":"jealousy","words":[{"w":"there","t":458.56},{"w":"was","t":458.72},{"w":"no","t":458.88},{"w":"jealousy","t":459.04},{"w":"to","t":459.52},{"w":"remember.","t":459.68}]},{"text":"It would have been better for you and less harmful for you to have accepted the","s":460.32,"e":463.96,"next":464,"key":"accepted","words":[{"w":"It","t":460.32},{"w":"would","t":460.47},{"w":"have","t":460.62},{"w":"been","t":460.77},{"w":"better","t":460.92},{"w":"for","t":461.2},{"w":"you","t":461.36},{"w":"and","t":461.6},{"w":"less","t":461.76},{"w":"harmful","t":462},{"w":"for","t":462.4},{"w":"you","t":462.64},{"w":"to","t":462.88},{"w":"have","t":463.04},{"w":"accepted","t":463.2},{"w":"the","t":463.6}]}]}
