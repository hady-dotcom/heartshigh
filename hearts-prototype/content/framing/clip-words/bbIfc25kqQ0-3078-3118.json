{"version":1,"youtubeId":"bbIfc25kqQ0","start":3078,"end":3118,"segments":[{"start":3078,"end":3118,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"they saw the state of the garden, they said,","s":3078.08,"e":3080.08,"next":3080.08,"key":"garden","words":[{"w":"they","t":3078.08},{"w":"saw","t":3078.24},{"w":"the","t":3078.4},{"w":"state","t":3078.64},{"w":"of","t":3078.8},{"w":"the","t":3078.96},{"w":"garden,","t":3079.12},{"w":"they","t":3079.44},{"w":"said,","t":3079.6}]},{"text":"We must have become lost on the way.","s":3080.08,"e":3082.32,"next":3082.32,"key":"become","words":[{"w":"We","t":3080.08},{"w":"must","t":3080.48},{"w":"have","t":3080.72},{"w":"become","t":3080.88},{"w":"lost","t":3081.28},{"w":"on","t":3081.52},{"w":"the","t":3081.76},{"w":"way.","t":3081.92}]},{"text":"This isn't the place at all.","s":3082.32,"e":3084,"next":3084,"key":"isn't","words":[{"w":"This","t":3082.32},{"w":"isn't","t":3082.56},{"w":"the","t":3082.8},{"w":"place","t":3082.96},{"w":"at","t":3083.2},{"w":"all.","t":3083.44}]},{"text":"Wait, it is the place.","s":3084,"e":3085.84,"next":3085.84,"key":"place","words":[{"w":"Wait,","t":3084},{"w":"it","t":3084.56},{"w":"is","t":3084.8},{"w":"the","t":3084.96},{"w":"place.","t":3085.2}]},{"text":"We've been forbidden from the gardens.","s":3085.84,"e":3088.4,"next":3088.4,"key":"forbidden","words":[{"w":"We've","t":3085.84},{"w":"been","t":3086.16},{"w":"forbidden","t":3086.31},{"w":"from","t":3086.72},{"w":"the","t":3086.88},{"w":"gardens.","t":3087.4}]},{"text":"The middle one among them said, Why did you not glorify him?","s":3088.4,"e":3092.96,"next":3092.96,"key":"glorify","words":[{"w":"The","t":3088.4},{"w":"middle","t":3088.64},{"w":"one","t":3088.88},{"w":"among","t":3089.04},{"w":"them","t":3089.36},{"w":"said,","t":3089.6},{"w":"Why","t":3090.16},{"w":"did","t":3090.64},{"w":"you","t":3090.88},{"w":"not","t":3091.04},{"w":"glorify","t":3091.28},{"w":"him?","t":3091.96}]},{"text":"They responded, Glory be to our Lord.","s":3092.96,"e":3095.28,"next":3095.28,"key":"responded","words":[{"w":"They","t":3092.96},{"w":"responded,","t":3093.28},{"w":"Glory","t":3093.84},{"w":"be","t":3094.4},{"w":"to","t":3094.64},{"w":"our","t":3094.8},{"w":"Lord.","t":3094.96}]},{"text":"We committed oppression.","s":3095.28,"e":3096.88,"next":3096.88,"key":"oppression","words":[{"w":"We","t":3095.28},{"w":"committed","t":3095.44},{"w":"oppression.","t":3095.88}]},{"text":"They then turned and started blaming one another for what happened.","s":3096.88,"e":3101.6,"next":3101.6,"key":"happened","words":[{"w":"They","t":3096.88},{"w":"then","t":3097.12},{"w":"turned","t":3097.36},{"w":"and","t":3097.6},{"w":"started","t":3097.84},{"w":"blaming","t":3098.16},{"w":"one","t":3098.56},{"w":"another","t":3098.72},{"w":"for","t":3098.96},{"w":"what","t":3099.2},{"w":"happened.","t":3100.6}]},{"text":"They said, Oh, woe to us.","s":3101.6,"e":3105.04,"next":3105.04,"key":"said","words":[{"w":"They","t":3101.6},{"w":"said,","t":3101.92},{"w":"Oh,","t":3102.88},{"w":"woe","t":3103.52},{"w":"to","t":3103.84},{"w":"us.","t":3104.08}]},{"text":"Look at the state of us.","s":3105.04,"e":3106.96,"next":3106.96,"key":"state","words":[{"w":"Look","t":3105.04},{"w":"at","t":3105.2},{"w":"the","t":3105.36},{"w":"state","t":3105.52},{"w":"of","t":3105.76},{"w":"us.","t":3105.96}]},{"text":"We transgressed the bounds.","s":3106.96,"e":3109.72,"next":3109.72,"key":"transgressed","words":[{"w":"We","t":3106.96},{"w":"transgressed","t":3107.28},{"w":"the","t":3108.08},{"w":"bounds.","t":3108.52}]},{"text":"Perhaps our Lord will replace this with something better,","s":3109.72,"e":3114.72,"next":3114.72,"key":"something","words":[{"w":"Perhaps","t":3109.72},{"w":"our","t":3110.72},{"w":"Lord","t":3111.04},{"w":"will","t":3111.36},{"w":"replace","t":3111.6},{"w":"this","t":3112},{"w":"with","t":3112.64},{"w":"something","t":3112.96},{"w":"better,","t":3113.72}]},{"text":"if we should turn towards 