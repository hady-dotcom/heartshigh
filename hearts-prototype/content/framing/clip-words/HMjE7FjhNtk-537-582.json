{"version":1,"youtubeId":"HMjE7FjhNtk","start":537,"end":582,"segments":[{"start":537,"end":582,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"He was one of his key opponents.","s":537.35,"e":538.4,"next":538.4,"key":"opponents","words":[{"w":"He","t":537.35},{"w":"was","t":537.5},{"w":"one","t":537.65},{"w":"of","t":537.8},{"w":"his","t":537.95},{"w":"key","t":538.1},{"w":"opponents.","t":538.25}]},{"text":"Why? Because he refused to accept the position of all the chief judge.","s":538.4,"e":546.36,"next":546.56,"key":"position","words":[{"w":"Why?","t":538.4},{"w":"Because","t":538.55},{"w":"he","t":539.36},{"w":"refused","t":539.6},{"w":"to","t":540.64},{"w":"accept","t":540.88},{"w":"the","t":541.52},{"w":"position","t":541.68},{"w":"of","t":542.24},{"w":"all","t":542.48},{"w":"the","t":542.64},{"w":"chief","t":544.64},{"w":"judge.","t":544.96}]},{"text":"Why was Imam Bohani for him?","s":546.56,"e":548.16,"next":548.16,"key":"Bohani","words":[{"w":"Why","t":546.56},{"w":"was","t":546.8},{"w":"Imam","t":547.04},{"w":"Bohani","t":547.28},{"w":"for","t":547.76},{"w":"him?","t":547.92}]},{"text":"Allah? Not a judge?","s":548.16,"e":549.36,"next":549.36,"key":"Allah","words":[{"w":"Allah?","t":548.16},{"w":"Not","t":548.48},{"w":"a","t":548.64},{"w":"judge?","t":548.8}]},{"text":"Of course, he was a judge, he was an absolute mushtahid.","s":549.36,"e":552.72,"next":552.72,"key":"mushtahid","words":[{"w":"Of","t":549.36},{"w":"course,","t":549.52},{"w":"he","t":549.76},{"w":"was","t":549.91},{"w":"a","t":550.06},{"w":"judge,","t":550.21},{"w":"he","t":550.88},{"w":"was","t":551.03},{"w":"an","t":551.18},{"w":"absolute","t":551.33},{"w":"mushtahid.","t":551.6}]},{"text":"Of course, he was a judge.","s":552.72,"e":553.68,"next":553.68,"key":"course","words":[{"w":"Of","t":552.72},{"w":"course,","t":552.87},{"w":"he","t":553.04},{"w":"was","t":553.2},{"w":"a","t":553.36},{"w":"judge.","t":553.51}]},{"text":"He memorized the Quran and thousands and thousands of a Hadith.","s":553.68,"e":557.04,"next":557.04,"key":"memorized","words":[{"w":"He","t":553.68},{"w":"memorized","t":553.83},{"w":"the","t":554.24},{"w":"Quran","t":554.39},{"w":"and","t":554.8},{"w":"thousands","t":555.6},{"w":"and","t":556},{"w":"thousands","t":556.16},{"w":"of","t":556.48},{"w":"a","t":556.63},{"w":"Hadith.","t":556.78}]},{"text":"Of course, he had 40 parties under him, of course, he was a judge,","s":557.04,"e":560,"next":560,"key":"parties","words":[{"w":"Of","t":557.04},{"w":"course,","t":557.19},{"w":"he","t":557.36},{"w":"had","t":557.51},{"w":"40","t":557.66},{"w":"parties","t":557.84},{"w":"under","t":558.24},{"w":"him,","t":558.4},{"w":"of","t":558.56},{"w":"course,","t":558.71},{"w":"he","t":558.88},{"w":"was","t":559.03},{"w":"a","t":559.18},{"w":"judge,","t":559.33}]},{"text":"and why didn't he accept the position?","s":560,"e":561.52,"next":561.52,"key":"position","words":[{"w":"and","t":560},{"w":"why","t":560.24},{"w":"didn't","t":560.4},{"w":"he","t":560.56},{"w":"accept","t":560.72},{"w":"the","t":561.04},{"w":"position?","t":561.19}]},{"text":"Because he knew by accepting the position of judiciary?","s":561.52,"e":564.96,"next":564.96,"key":"accepting","words":[{"w":"Because","t":561.52},{"w":"he","t":561.76},{"w":"knew","t":561.92},{"w":"by","t":562.56},{"w":"accepting","t":562.72},{"w":"the","t":563.36},{"w":"position","t":563.6},{"w":"of","t":564.08},{"w":"judiciary?","t":564.24}]},{"text":"Within the Khilafah system, it would be impossible for him to give fatwa","s":564.96,"e":570.56,"next":570.56,"key":"impossible","words":[{"w":"Within","t":564.96},{"w":"the","t":565.36},{"w":"Khilafah","t":565.52},{"w":"system,","t":566.16},{"w":"it","t":567.04},{"w":"would","t":567.19},{"w":"be","t":567.34},{"w":"impossible","t":567.52},{"w":"for","t":568.4},{"w":"him","t":568.64},{"w":"to","t":569.52},{"w":"give","t":569.68},{"w":"fatwa","t":570}]},{"text":"against them, and it would be impossible for him in the case.","s":570.56,"e":575.12,"next":575.12,"key":"impossible","words":[{"w":"against","t":570.56},{"w":"them,","t":570.96},{"w":"and","t":571.68},{"w":"it","t":571.84},{"w":"would","t":571.99},{"w":"be","t":572.14},{"w":"impossible","t":572.29},{"w":"for","t":573.04},{"w":"him","t":573.28},{"w":"in","t":574.56},{"w":"the","t":574.72},{"w":"case.","t":574.88}]},{"text":"Where he would be now taking money from Abu Jafar and so taking agreement","s":575.12,"e":579.04,"next":579.04,"key":"agreement","words":[{"w":"Where","t":575.12},{"w":"he","t":575.28},{"w":"would","t":575.44},{"w":"be","t":575.6},{"w":"now","t":575.75},{"w":"taking","t":576},{"w":"money","t":576.4},{"w":"from","t":576.72},{"w":"Abu","t":576.88},{"w":"Jafar","t":577.2},{"w":"and","t":577.6},{"w":"so","t":577.75},{"w":"taking","t":578},{"w":"agreement","t":578.64}]},{"text":"from him to disagree with his rule.","s":579.04,"e":582,"next":582,"key":"disagree","words":[{"w":"from","t":579.04},{"w":"him","t":579.28},{"w":"to","t":579.76},{"w":"disagree","t":580},{"w":"with","t":580.72},{"w":"his","t":580.88},{"w":"rule.","t":581.12}]}]}
