{"version":1,"youtubeId":"xfPpeDq0xTE","start":583,"end":626,"segments":[{"start":583,"end":626,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"And as we wrapped up, this young woman who was blind, she couldn't see.","s":583.44,"e":587.84,"next":587.84,"key":"couldn't","words":[{"w":"And","t":583.44},{"w":"as","t":583.6},{"w":"we","t":583.84},{"w":"wrapped","t":584},{"w":"up,","t":584.32},{"w":"this","t":584.88},{"w":"young","t":585.12},{"w":"woman","t":585.36},{"w":"who","t":585.68},{"w":"was","t":585.92},{"w":"blind,","t":586.08},{"w":"she","t":586.56},{"w":"couldn't","t":586.8},{"w":"see.","t":587.12}]},{"text":"She said to me, You know, I thought you'd be a lot taller.","s":587.84,"e":591.56,"next":592.72,"key":"thought","words":[{"w":"She","t":587.84},{"w":"said","t":588},{"w":"to","t":588.24},{"w":"me,","t":588.4},{"w":"You","t":588.72},{"w":"know,","t":588.96},{"w":"I","t":589.12},{"w":"thought","t":589.28},{"w":"you'd","t":589.44},{"w":"be","t":589.68},{"w":"a","t":589.84},{"w":"lot","t":590},{"w":"taller.","t":590.16}]},{"text":"I said, What?","s":592.72,"e":594.44,"next":595.12,"key":"said","words":[{"w":"I","t":592.72},{"w":"said,","t":592.88},{"w":"What?","t":593.04}]},{"text":"And she said, Your voice, It's not coming from up here,","s":595.12,"e":599.04,"next":599.04,"key":"coming","words":[{"w":"And","t":595.12},{"w":"she","t":595.36},{"w":"said,","t":595.52},{"w":"Your","t":595.67},{"w":"voice,","t":596},{"w":"It's","t":596.48},{"w":"not","t":596.8},{"w":"coming","t":597.04},{"w":"from","t":597.36},{"w":"up","t":597.6},{"w":"here,","t":597.84}]},{"text":"but it's coming from down here.","s":599.04,"e":601.6,"next":601.6,"key":"coming","words":[{"w":"but","t":599.04},{"w":"it's","t":599.28},{"w":"coming","t":599.52},{"w":"from","t":599.76},{"w":"down","t":600.08},{"w":"here.","t":600.4}]},{"text":"And I said, Oh.","s":601.6,"e":603.4,"next":603.6,"key":"said","words":[{"w":"And","t":601.6},{"w":"I","t":601.76},{"w":"said,","t":601.92},{"w":"Oh.","t":602.07}]},{"text":"And one of my students who was with me, he","s":603.6,"e":605.52,"next":605.52,"key":"students","words":[{"w":"And","t":603.6},{"w":"one","t":603.84},{"w":"of","t":604},{"w":"my","t":604.15},{"w":"students","t":604.32},{"w":"who","t":604.56},{"w":"was","t":604.8},{"w":"with","t":604.96},{"w":"me,","t":605.12},{"w":"he","t":605.36}]},{"text":"said, Isn't that remarkable?","s":605.52,"e":607.28,"next":607.28,"key":"remarkable","words":[{"w":"said,","t":605.52},{"w":"Isn't","t":605.68},{"w":"that","t":606.16},{"w":"remarkable?","t":606.48}]},{"text":"She's blind and she could tell how short you are.","s":607.28,"e":610.84,"next":612,"key":"She's","words":[{"w":"She's","t":607.28},{"w":"blind","t":607.68},{"w":"and","t":608},{"w":"she","t":608.24},{"w":"could","t":608.48},{"w":"tell","t":608.64},{"w":"how","t":608.8},{"w":"short","t":609.04},{"w":"you","t":609.28},{"w":"are.","t":609.44}]},{"text":"And outside, I said, Oh, yeah, that's so amazing.","s":612,"e":615.6,"next":615.6,"key":"outside","words":[{"w":"And","t":612},{"w":"outside,","t":612.24},{"w":"I","t":612.72},{"w":"said,","t":612.96},{"w":"Oh,","t":613.12},{"w":"yeah,","t":613.6},{"w":"that's","t":613.76},{"w":"so","t":614},{"w":"amazing.","t":614.24}]},{"text":"But inside I was thinking, Man, how short am I?","s":615.6,"e":618.32,"next":618.32,"key":"thinking","words":[{"w":"But","t":615.6},{"w":"inside","t":615.84},{"w":"I","t":616.24},{"w":"was","t":616.48},{"w":"thinking,","t":616.64},{"w":"Man,","t":616.88},{"w":"how","t":617.52},{"w":"short","t":617.76},{"w":"am","t":618},{"w":"I?","t":618.16}]},{"text":"A blind woman just told me I'm short.","s":618.32,"e":621.32,"next":622.8,"key":"blind","words":[{"w":"A","t":618.32},{"w":"blind","t":618.56},{"w":"woman","t":618.8},{"w":"just","t":619.12},{"w":"told","t":619.36},{"w":"me","t":619.52},{"w":"I'm","t":619.68},{"w":"short.","t":619.92}]},{"text":"She didn't need eyes to see.","s":622.8,"e":625.88,"next":626,"key":"didn't","words":[{"w":"She","t":622.8},{"w":"didn't","t":623.12},{"w":"need","t":623.44},{"w":"eyes","t":623.92},{"w":"to","t":624.4},{"w":"see.","t":624.64}]}]}
