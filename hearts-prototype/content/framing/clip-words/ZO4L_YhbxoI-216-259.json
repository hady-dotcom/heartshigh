{"version":1,"youtubeId":"ZO4L_YhbxoI","start":216,"end":259,"segments":[{"start":216,"end":259,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"These are all Muslim cities, Muslim ports, and, uh, the caliph.","s":216,"e":221.2,"next":221.2,"key":"Muslim","words":[{"w":"These","t":216},{"w":"are","t":216.16},{"w":"all","t":216.32},{"w":"Muslim","t":216.47},{"w":"cities,","t":216.8},{"w":"Muslim","t":217.36},{"w":"ports,","t":217.84},{"w":"and,","t":219.52},{"w":"uh,","t":220.08},{"w":"the","t":220.48},{"w":"caliph.","t":220.72}]},{"text":"At that time, his name was Abdulrahman III.","s":221.2,"e":224.68,"next":226.08,"key":"Abdulrahman","words":[{"w":"At","t":221.2},{"w":"that","t":221.36},{"w":"time,","t":221.6},{"w":"his","t":221.92},{"w":"name","t":222.08},{"w":"was","t":222.24},{"w":"Abdulrahman","t":222.4},{"w":"III.","t":223.28}]},{"text":"He said he was building the mosque of Cordova.","s":226.08,"e":229.44,"next":229.44,"key":"building","words":[{"w":"He","t":226.08},{"w":"said","t":226.48},{"w":"he","t":226.8},{"w":"was","t":226.96},{"w":"building","t":227.12},{"w":"the","t":227.44},{"w":"mosque","t":227.6},{"w":"of","t":228},{"w":"Cordova.","t":228.15}]},{"text":"And he said, I won't put a brick on another brick until we get rid of these","s":229.44,"e":235.68,"next":235.68,"key":"another","words":[{"w":"And","t":229.44},{"w":"he","t":229.6},{"w":"said,","t":229.84},{"w":"I","t":230.08},{"w":"won't","t":230.24},{"w":"put","t":230.56},{"w":"a","t":231.36},{"w":"brick","t":231.52},{"w":"on","t":231.92},{"w":"another","t":232.08},{"w":"brick","t":232.48},{"w":"until","t":233.04},{"w":"we","t":233.44},{"w":"get","t":233.68},{"w":"rid","t":233.92},{"w":"of","t":234.16},{"w":"these","t":234.4}]},{"text":"fire worshipers.","s":235.68,"e":236.72,"next":236.72,"key":"worshipers","words":[{"w":"fire","t":235.68},{"w":"worshipers.","t":236.08}]},{"text":"He called them fire worshipers.","s":236.72,"e":238,"next":238,"key":"worshipers","words":[{"w":"He","t":236.72},{"w":"called","t":236.88},{"w":"them","t":237.12},{"w":"fire","t":237.28},{"w":"worshipers.","t":237.52}]},{"text":"He also called them Normans, Northmen, Noorman.","s":238,"e":241.12,"next":241.12,"key":"Northmen","words":[{"w":"He","t":238},{"w":"also","t":238.16},{"w":"called","t":238.4},{"w":"them","t":238.56},{"w":"Normans,","t":238.72},{"w":"Northmen,","t":239.44},{"w":"Noorman.","t":240.48}]},{"text":"They called them Northmen's.","s":241.12,"e":242.16,"next":242.16,"key":"Northmen's","words":[{"w":"They","t":241.12},{"w":"called","t":241.28},{"w":"them","t":241.44},{"w":"Northmen's.","t":241.68}]},{"text":"They called themselves Northmen as well, he said.","s":242.16,"e":245.2,"next":245.2,"key":"themselves","words":[{"w":"They","t":242.16},{"w":"called","t":242.32},{"w":"themselves","t":242.48},{"w":"Northmen","t":242.88},{"w":"as","t":243.36},{"w":"well,","t":243.51},{"w":"he","t":244.8},{"w":"said.","t":244.96}]},{"text":"I won't do, he says.","s":245.2,"e":246.24,"next":246.24,"key":"won't","words":[{"w":"I","t":245.2},{"w":"won't","t":245.52},{"w":"do,","t":245.68},{"w":"he","t":245.92},{"w":"says.","t":246.08}]},{"text":"Stop the mosque, he said.","s":246.24,"e":247.52,"next":247.52,"key":"mosque","words":[{"w":"Stop","t":246.24},{"w":"the","t":246.56},{"w":"mosque,","t":246.8},{"w":"he","t":247.2},{"w":"said.","t":247.35}]},{"text":"We will fight these people, we will defeat these people,","s":247.52,"e":250,"next":250,"key":"people","words":[{"w":"We","t":247.52},{"w":"will","t":247.68},{"w":"fight","t":248},{"w":"these","t":248.32},{"w":"people,","t":248.56},{"w":"we","t":248.8},{"w":"will","t":248.96},{"w":"defeat","t":249.12},{"w":"these","t":249.52},{"w":"people,","t":249.76}]},{"text":"We'll teach them a lesson, you don't do this to our cities,","s":250,"e":253.04,"next":253.04,"key":"lesson","words":[{"w":"We'll","t":250},{"w":"teach","t":250.16},{"w":"them","t":250.4},{"w":"a","t":250.64},{"w":"lesson,","t":250.79},{"w":"you","t":251.2},{"w":"don't","t":251.36},{"w":"do","t":251.6},{"w":"this","t":251.76},{"w":"to","t":251.92},{"w":"our","t":252.08},{"w":"cities,","t":252.24}]},{"text":"you want to trade with us, that's one thing, but you want to do this, no,","s":253.04,"e":257.12,"next":257.12,"key":"that's","words":[{"w":"you","t":253.04},{"w":"want","t":253.2},{"w":"to","t":253.36},{"w":"trade","t":253.52},{"w":"with","t":253.76},{"w":"us,","t":254},{"w":"that's","t":254.16},{"w":"one","t":254.4},{"w":"thing,","t":254.64},{"w":"but","t":255.68},{"w":"you","t":255.84},{"w":"want","t":256.08},{"w":"to","t":256.24},{"w":"do","t":256.39},{"w":"this,","t":256.56},{"w":"no,","t":256.8}]},{"text":"we will teach you a lesson.","s":257.12,"e":258.84,"next":259,"key":"lesson","words":[{"w":"we","t":257.12},{"w":"will","t":257.28},{"w":"teach","t":257.44},{"w":"you","t":257.68},{"w":"a","t":257.84},{"w":"lesson.","t":257.99}]}]}
