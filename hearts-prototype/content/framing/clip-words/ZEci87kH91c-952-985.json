{"version":1,"youtubeId":"ZEci87kH91c","start":952,"end":985,"segments":[{"start":952,"end":985,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"And he said, What do you want to do?","s":952,"e":953.86,"next":953.86,"key":"said","words":[{"w":"And","t":952},{"w":"he","t":952.15},{"w":"said,","t":952.3},{"w":"What","t":952.96},{"w":"do","t":953.11},{"w":"you","t":953.26},{"w":"want","t":953.41},{"w":"to","t":953.56},{"w":"do?","t":953.71}]},{"text":"He said. I want to be like them.","s":953.86,"e":955.06,"next":955.06,"key":"said","words":[{"w":"He","t":953.86},{"w":"said.","t":954.01},{"w":"I","t":954.16},{"w":"want","t":954.31},{"w":"to","t":954.46},{"w":"be","t":954.61},{"w":"like","t":954.76},{"w":"them.","t":954.91}]},{"text":"He said. Then you have to declare that.","s":955.06,"e":956.26,"next":956.26,"key":"declare","words":[{"w":"He","t":955.06},{"w":"said.","t":955.21},{"w":"Then","t":955.36},{"w":"you","t":955.51},{"w":"have","t":955.66},{"w":"to","t":955.81},{"w":"declare","t":955.96},{"w":"that.","t":956.11}]},{"text":"He said. I declare it.","s":956.26,"e":957.32,"next":957.32,"key":"declare","words":[{"w":"He","t":956.26},{"w":"said.","t":956.41},{"w":"I","t":956.56},{"w":"declare","t":956.71},{"w":"it.","t":956.86}]},{"text":"He said. The moment he said, Ashhadu an la Ilaha illallah wa ashhadu anna Muhammadan","s":957.32,"e":962.88,"next":962.88,"key":"Muhammadan","words":[{"w":"He","t":957.32},{"w":"said.","t":957.47},{"w":"The","t":957.64},{"w":"moment","t":957.79},{"w":"he","t":958.04},{"w":"said,","t":958.19},{"w":"Ashhadu","t":958.52},{"w":"an","t":959.12},{"w":"la","t":959.28},{"w":"Ilaha","t":959.56},{"w":"illallah","t":960.04},{"w":"wa","t":961.04},{"w":"ashhadu","t":961.24},{"w":"anna","t":961.8},{"w":"Muhammadan","t":962.16}]},{"text":"Abduhu wa Rasuluh, the moment he said, Rasuluh, he died.","s":962.88,"e":967.96,"next":971.75,"key":"Rasuluh","words":[{"w":"Abduhu","t":962.88},{"w":"wa","t":963.36},{"w":"Rasuluh,","t":963.51},{"w":"the","t":964.84},{"w":"moment","t":964.99},{"w":"he","t":965.14},{"w":"said,","t":965.29},{"w":"Rasuluh,","t":965.44},{"w":"he","t":966.44},{"w":"died.","t":966.59}]},{"text":"This is good, end. This, as the Prophet says, La Ilaha illallah tajubbu ma qablah.","s":971.75,"e":976.48,"next":976.48,"key":"illallah","words":[{"w":"This","t":971.75},{"w":"is","t":971.9},{"w":"good,","t":972.05},{"w":"end.","t":972.2},{"w":"This,","t":972.35},{"w":"as","t":972.72},{"w":"the","t":972.88},{"w":"Prophet","t":973.03},{"w":"says,","t":973.48},{"w":"La","t":974.12},{"w":"Ilaha","t":974.36},{"w":"illallah","t":974.76},{"w":"tajubbu","t":975.2},{"w":"ma","t":975.64},{"w":"qablah.","t":975.79}]},{"text":"Once you say it from your heart, with sincerity,","s":976.48,"e":979.08,"next":979.08,"key":"sincerity","words":[{"w":"Once","t":976.48},{"w":"you","t":976.76},{"w":"say","t":976.92},{"w":"it","t":977.16},{"w":"from","t":977.32},{"w":"your","t":977.52},{"w":"heart,","t":977.72},{"w":"with","t":978.04},{"w":"sincerity,","t":978.19}]},{"text":"everything you have done in your past is wiped away.","s":979.08,"e":982.56,"next":982.56,"key":"everything","words":[{"w":"everything","t":979.08},{"w":"you","t":979.76},{"w":"have","t":979.91},{"w":"done","t":980.06},{"w":"in","t":980.24},{"w":"your","t":980.39},{"w":"past","t":980.54},{"w":"is","t":980.76},{"w":"wiped","t":980.91},{"w":"away.","t":981.16}]},{"text":"Your slate is clean.","s":982.56,"e":984.6,"next":985,"key":"slate","words":[{"w":"Your","t":982.56},{"w":"slate","t":982.72},{"w":"is","t":983.08},{"w":"clean.","t":983.23}]}]}
