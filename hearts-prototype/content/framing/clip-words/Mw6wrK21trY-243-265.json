{"version":1,"youtubeId":"Mw6wrK21trY","start":243,"end":265,"segments":[{"start":243,"end":265,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"know, when he left, they said, Who's that?","s":243.3,"e":246.12,"next":246.12,"key":"Who's","words":[{"w":"know,","t":243.3},{"w":"when","t":243.45},{"w":"he","t":243.6},{"w":"left,","t":243.75},{"w":"they","t":243.9},{"w":"said,","t":244.5},{"w":"Who's","t":245.4},{"w":"that?","t":245.94}]},{"text":"He told them? Do you know who that is?","s":246.12,"e":247.59,"next":247.59,"key":"told","words":[{"w":"He","t":246.12},{"w":"told","t":246.36},{"w":"them?","t":246.54},{"w":"Do","t":246.69},{"w":"you","t":246.84},{"w":"know","t":246.99},{"w":"who","t":247.14},{"w":"that","t":247.29},{"w":"is?","t":247.44}]},{"text":"He said. Allah in his message and all best, he said.","s":247.59,"e":249.24,"next":249.24,"key":"message","words":[{"w":"He","t":247.59},{"w":"said.","t":247.74},{"w":"Allah","t":247.89},{"w":"in","t":248.04},{"w":"his","t":248.19},{"w":"message","t":248.34},{"w":"and","t":248.49},{"w":"all","t":248.64},{"w":"best,","t":248.79},{"w":"he","t":248.94},{"w":"said.","t":249.09}]},{"text":"That was Jibril, by the way.","s":249.24,"e":251.72,"next":252.26,"key":"Jibril","words":[{"w":"That","t":249.24},{"w":"was","t":249.39},{"w":"Jibril,","t":249.54},{"w":"by","t":249.9},{"w":"the","t":250.2},{"w":"way.","t":250.35}]},{"text":"He came to teach you your Deen, to summate for you your Deen.","s":252.26,"e":256.68,"next":256.68,"key":"summate","words":[{"w":"He","t":252.26},{"w":"came","t":253.26},{"w":"to","t":253.44},{"w":"teach","t":253.68},{"w":"you","t":253.92},{"w":"your","t":254.1},{"w":"Deen,","t":254.4},{"w":"to","t":254.82},{"w":"summate","t":255.42},{"w":"for","t":255.78},{"w":"you","t":255.96},{"w":"your","t":256.14},{"w":"Deen.","t":256.32}]},{"text":"What part of the Deen did he begin with?","s":256.68,"e":258.66,"next":258.66,"key":"begin","words":[{"w":"What","t":256.68},{"w":"part","t":257.28},{"w":"of","t":257.46},{"w":"the","t":257.64},{"w":"Deen","t":257.79},{"w":"did","t":257.94},{"w":"he","t":258.12},{"w":"begin","t":258.27},{"w":"with?","t":258.42}]},{"text":"The part of the Deen he started with good manners, Salaam.","s":258.66,"e":264.44,"next":265,"key":"started","words":[{"w":"The","t":258.66},{"w":"part","t":259.14},{"w":"of","t":259.68},{"w":"the","t":259.83},{"w":"Deen","t":259.98},{"w":"he","t":260.22},{"w":"started","t":260.76},{"w":"with","t":261.12},{"w":"good","t":261.48},{"w":"manners,","t":261.9},{"w":"Salaam.","t":263.04}]}]}
