{"version":1,"youtubeId":"It6K7vZdcIE","start":1651,"end":1695,"segments":[{"start":1651,"end":1695,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"You have an argument at home and you say I didn't do anything.","s":1651.04,"e":1654.48,"next":1654.48,"key":"argument","words":[{"w":"You","t":1651.04},{"w":"have","t":1651.2},{"w":"an","t":1651.35},{"w":"argument","t":1651.5},{"w":"at","t":1651.76},{"w":"home","t":1651.92},{"w":"and","t":1652.08},{"w":"you","t":1652.24},{"w":"say","t":1652.39},{"w":"I","t":1652.64},{"w":"didn't","t":1652.8},{"w":"do","t":1652.96},{"w":"anything.","t":1653.48}]},{"text":"That argument did not come for no reason.","s":1654.48,"e":1657.92,"next":1657.92,"key":"argument","words":[{"w":"That","t":1654.48},{"w":"argument","t":1654.72},{"w":"did","t":1655.2},{"w":"not","t":1655.36},{"w":"come","t":1655.52},{"w":"for","t":1655.68},{"w":"no","t":1655.84},{"w":"reason.","t":1656.92}]},{"text":"Why did that happen?","s":1657.92,"e":1663.5,"next":1663.5,"key":"happen","words":[{"w":"Why","t":1657.92},{"w":"did","t":1658.16},{"w":"that","t":1658.4},{"w":"happen?","t":1663.35}]},{"text":"That happened because Allah is testing you to see how will you behave?","s":1663.5,"e":1668.32,"next":1668.32,"key":"happened","words":[{"w":"That","t":1663.5},{"w":"happened","t":1663.65},{"w":"because","t":1663.8},{"w":"Allah","t":1663.95},{"w":"is","t":1664.1},{"w":"testing","t":1664.25},{"w":"you","t":1664.4},{"w":"to","t":1664.8},{"w":"see","t":1665.04},{"w":"how","t":1665.28},{"w":"will","t":1665.52},{"w":"you","t":1665.68},{"w":"behave?","t":1667.32}]},{"text":"What direction will you take?","s":1668.32,"e":1670.64,"next":1670.64,"key":"direction","words":[{"w":"What","t":1668.32},{"w":"direction","t":1668.64},{"w":"will","t":1669.04},{"w":"you","t":1669.28},{"w":"take?","t":1669.52}]},{"text":"Are you going to be aggressive?","s":1670.64,"e":1672.64,"next":1672.64,"key":"aggressive","words":[{"w":"Are","t":1670.64},{"w":"you","t":1670.8},{"w":"going","t":1670.96},{"w":"to","t":1671.11},{"w":"be","t":1671.26},{"w":"aggressive?","t":1671.64}]},{"text":"Are you going to be rude and vulgar?","s":1672.64,"e":1675.36,"next":1675.36,"key":"vulgar","words":[{"w":"Are","t":1672.64},{"w":"you","t":1672.8},{"w":"going","t":1672.96},{"w":"to","t":1673.11},{"w":"be","t":1673.26},{"w":"rude","t":1673.41},{"w":"and","t":1673.6},{"w":"vulgar?","t":1674.36}]},{"text":"Are you going to be wicked and evil?","s":1675.36,"e":1678.4,"next":1678.4,"key":"wicked","words":[{"w":"Are","t":1675.36},{"w":"you","t":1675.52},{"w":"going","t":1675.68},{"w":"to","t":1675.84},{"w":"be","t":1675.99},{"w":"wicked","t":1676.14},{"w":"and","t":1676.48},{"w":"evil?","t":1677.4}]},{"text":"Are you going to be forgiving and merciful?","s":1678.4,"e":1681.52,"next":1681.52,"key":"forgiving","words":[{"w":"Are","t":1678.4},{"w":"you","t":1678.64},{"w":"going","t":1678.79},{"w":"to","t":1678.94},{"w":"be","t":1679.09},{"w":"forgiving","t":1679.24},{"w":"and","t":1679.52},{"w":"merciful?","t":1680.52}]},{"text":"Are you going to be somebody who will try to remove that difficulty with","s":1681.52,"e":1687.28,"next":1687.28,"key":"difficulty","words":[{"w":"Are","t":1681.52},{"w":"you","t":1681.76},{"w":"going","t":1681.92},{"w":"to","t":1682.07},{"w":"be","t":1682.22},{"w":"somebody","t":1682.48},{"w":"who","t":1683.2},{"w":"will","t":1683.44},{"w":"try","t":1683.68},{"w":"to","t":1683.92},{"w":"remove","t":1684.76},{"w":"that","t":1685.76},{"w":"difficulty","t":1686.08},{"w":"with","t":1686.96}]},{"text":"doing that, which is good?","s":1687.28,"e":1688.72,"next":1688.72,"key":"doing","words":[{"w":"doing","t":1687.28},{"w":"that,","t":1687.6},{"w":"which","t":1687.76},{"w":"is","t":1687.92},{"w":"good?","t":1688.16}]},{"text":"Allah said in the Quran, Follow the evil with good.","s":1688.72,"e":1693.36,"next":1693.36,"key":"Follow","words":[{"w":"Allah","t":1688.72},{"w":"said","t":1688.96},{"w":"in","t":1689.12},{"w":"the","t":1689.28},{"w":"Quran,","t":1691.08},{"w":"Follow","t":1692.08},{"w":"the","t":1692.4},{"w":"evil","t":1692.56},{"w":"with","t":1692.88},{"w":"good.","t":1693.12}]},{"text":"It will wipe it away.","s":1693.36,"e":1695,"next":1695,"key":"wipe","words":[{"w":"It","t":1693.36},{"w":"will","t":1693.52},{"w":"wipe","t":1693.68},{"w":"it","t":1694},{"w":"away.","t":1694.16}]}]}
