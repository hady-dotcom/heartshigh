{"version":1,"youtubeId":"ja7eQxc9BR8","start":51,"end":75,"segments":[{"start":51,"end":75,"mode":"F","confidence":0,"focus":{"x":0.5,"y":0.45}}],"sentences":[{"text":"And here's a Qur'anic leadership principle.","s":51.16,"e":53.81,"next":53.81,"key":"leadership","words":[{"w":"And","t":51.16},{"w":"here's","t":51.35},{"w":"a","t":51.69},{"w":"Qur'anic","t":51.84},{"w":"leadership","t":52.22},{"w":"principle.","t":52.75}]},{"text":"Knowledge must produce humility.","s":53.81,"e":56.97,"next":57,"key":"Knowledge","words":[{"w":"Knowledge","t":53.81},{"w":"must","t":54.58},{"w":"produce","t":54.96},{"w":"humility.","t":55.57}]},{"text":"Otherwise, a person may become prideful.","s":57,"e":60.02,"next":60.02,"key":"Otherwise","words":[{"w":"Otherwise,","t":57},{"w":"a","t":57.67},{"w":"person","t":57.82},{"w":"may","t":58.22},{"w":"become","t":58.46},{"w":"prideful.","t":58.89}]},{"text":"Leadership thinkers and experts will say something similar.","s":60.02,"e":63.6,"next":63.6,"key":"Leadership","words":[{"w":"Leadership","t":60.02},{"w":"thinkers","t":60.58},{"w":"and","t":61.05},{"w":"experts","t":61.25},{"w":"will","t":61.66},{"w":"say","t":61.92},{"w":"something","t":62.12},{"w":"similar.","t":62.64}]},{"text":"Competence without character can become a leadership hazard.","s":63.6,"e":67.24,"next":67.24,"key":"Competence","words":[{"w":"Competence","t":63.6},{"w":"without","t":64.14},{"w":"character","t":64.53},{"w":"can","t":65.03},{"w":"become","t":65.22},{"w":"a","t":65.57},{"w":"leadership","t":65.72},{"w":"hazard.","t":66.21}]},{"text":"People don't follow knowledge alone.","s":67.24,"e":70.1,"next":70.1,"key":"knowledge","words":[{"w":"People","t":67.24},{"w":"don't","t":67.68},{"w":"follow","t":68.06},{"w":"knowledge","t":68.51},{"w":"alone.","t":69.14}]},{"text":"They follow trust.","s":70.1,"e":71.7,"next":71.7,"key":"follow","words":[{"w":"They","t":70.1},{"w":"follow","t":70.36},{"w":"trust.","t":70.72}]},{"text":"They follow sincerity.","s":71.7,"e":73.02,"next":73.02,"key":"sincerity","words":[{"w":"They","t":71.7},{"w":"follow","t":71.92},{"w":"sincerity.","t":72.22}]},{"text":"They follow ethics and principles.","s":73.02,"e":75,"next":75,"key":"principles","words":[{"w":"They","t":73.02},{"w":"follow","t":73.34},{"w":"ethics","t":73.79},{"w":"and","t":74.23},{"w":"principles.","t":74.49}]}]}
