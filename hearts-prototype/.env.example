# Copy to .env on your own computer only if you want to override a default.
# The live server needs the variables in DEPLOY.md. Do not commit a filled-in .env.

# postgres://user:password@host:5432/hearts  or  file:./data/hearts.db
# Leave unset on your own computer to keep using SQLite.
DATABASE_URL=file:./data/hearts.db
# Optional. postgres or sqlite. If unset, the address above decides.
DATABASE_ADAPTER=

# Required on the live server. At least 32 random characters. Not a demo password.
PAYLOAD_SECRET=

# Public address, no slash at the end. https:// on the live server.
SERVER_URL=http://127.0.0.1:3000

# Bucket. On Railway you can use BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY, REGION and ENDPOINT instead.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
# 1 for MinIO. Leave unset for Railway and Amazon.
S3_FORCE_PATH_STYLE=

# 1 on Railway and Render. 0 if nothing sits in front of the app.
# On Fly you can leave this unset; Fly-Client-IP is used instead.
HEARTS_TRUSTED_PROXY_HOPS=
# A header the platform overwrites. Never set this to x-forwarded-for.
HEARTS_CLIENT_IP_HEADER=

# Used once, by npm run bootstrap. Not the demo passwords in the README.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
