{
  "name": "hearts-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HEARTS prototype: Payload CMS portals and a phone-friendly learner app.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "go": "node scripts/setup.mjs --start",
    "predev": "node scripts/ensure-seed.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "tsx scripts/start-production.ts",
    "migrate": "tsx scripts/migrate.ts",
    "approve:imported": "tsx scripts/approve-imported-questions.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "tidy:lines": "tsx scripts/tidy-lines.ts",
    "seed": "tsx src/seed/seed.ts",
    "seed:starters": "tsx src/seed/seed.ts --starters",
    "demo:timed-learners": "tsx src/seed/timed-learners.ts",
    "demo:compass": "tsx src/seed/compass-demo.ts",
    "reseed": "tsx src/seed/seed.ts --reset",
    "generate:importmap": "tsx scripts/generate-importmap.ts",
    "generate:types": "tsx scripts/generate-types.ts",
    "test:unit": "tsx --test src/lib/*.test.ts tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "typography:export": "tsx scripts/export-typography.ts",
    "typography:render": "npm --prefix ../remotion run render"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/db-sqlite": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/plugin-multi-tenant": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "exceljs": "^4.4.0",
    "graphql": "^16.11.0",
    "next": "^15.4.11",
    "payload": "^3.90.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "postcss": "^8.5.28",
    "sharp": "$sharp"
  }
}
